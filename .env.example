# Copy to .env (same folder) and fill in. .env is git-ignored; never commit it.
# One file serves the website build and every strategy under strategies/.

# --- Schwab (SPX options + VIX family) -------------------------------------------
# From developer.schwab.com -> Dashboard -> your app. The callback must match the app's
# registered callback URL exactly.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Written for you by: cd strategies/iron-fly-condor && python3 -m ironfly schwab-login
# Lasts about 7 days; rerun schwab-login when it expires. Access tokens (30 min) are
# fetched automatically on every run and never stored.
SCHWAB_REFRESH_TOKEN=

# Optional manual override: a raw access token, used instead of the refresh flow.
# SCHWAB_ACCESS_TOKEN=

# --- Alpaca (optional; SPY options as an SPX proxy) -------------------------------
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- Optional ----------------------------------------------------------------------
# IRONFLY_PATH=strategies/iron-fly-condor
